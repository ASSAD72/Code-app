{
  "name": "codex-desktop",
  "version": "1.0.0",
  "description": "CodeX Desktop \u2014 Local-first AI-assisted software development, build, and execution environment with sandboxed, multi-language, self-healing build pipelines.",
  "private": true,
  "main": "dist/gui/main.js",
  "bin": {
    "codex": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/resolve-runtime-aliases.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && electron dist/gui/main.js",
    "cli": "npm run build && node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package:win": "npm run build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "dockerode": "^4.0.2",
    "electron-store": "^10.0.0",
    "node-pty": "^1.0.0",
    "semver": "^7.6.3",
    "simple-git": "^3.27.0",
    "tar": "^7.4.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "yauzl": "^3.1.3",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/semver": "^7.5.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "eslint": "^8.57.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "build": {
    "appId": "com.codex.desktop",
    "productName": "CodeX Desktop",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "src/gui/renderer/**/*",
      "docker/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docker",
        "to": "docker"
      }
    ]
  }
}
